# Public website URL
NEXT_PUBLIC_SITE_URL=https://casanjaygulati.in

# App URL used for password reset links
APP_URL=http://localhost:3000

# Secret used by the Vercel weekly timesheet cron route
CRON_SECRET=change-me

# Neon Postgres connection strings
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Seeded admin account values
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=change-me
ADMIN_SEED_EMAIL=sg100868@gmail.com

# Optional SMTP settings for forgot-password emails
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@casanjaygulati.in

# Optional future contact destination for third-party form service integration
CONTACT_EMAIL=contact@casanjaygulati.in
