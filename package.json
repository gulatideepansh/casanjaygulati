{
  "name": "casanjaygulati-in",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "node --env-file=.env --env-file=.env.local ./node_modules/prisma/build/index.js migrate dev",
    "db:push": "node --env-file=.env --env-file=.env.local ./node_modules/prisma/build/index.js db push",
    "db:setup": "npm run db:push && npm run db:seed",
    "db:seed": "node --env-file=.env --env-file=.env.local prisma/seed.mjs",
    "db:import:production": "node --env-file=.env --env-file=.env.production-db scripts/migrate-sqlite-to-postgres.mjs"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.19.3",
    "lucide-react": "^0.544.0",
    "next": "^15.5.14",
    "nodemailer": "^8.0.4",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.6",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.23.0",
    "eslint-config-next": "^15.5.14",
    "postcss": "^8.5.3",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3"
  }
}
